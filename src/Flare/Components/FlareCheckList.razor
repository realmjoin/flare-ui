@namespace Flare
@typeparam TItem
@using Microsoft.AspNetCore.Components.Web.Virtualization

<div @attributes="RootAttributes()" class="@RootClass()">
    @if (ShowSearch)
    {
        <div class="@(Headless ? null : "flare-checklist-search")">
            <input type="text"
                   role="searchbox"
                   aria-label="@(SearchLabel ?? Locale.Ui("filter"))"
                   aria-controls="@_listId"
                   autocomplete="off"
                   class="@(Headless ? null : "flare-checklist-search-input")"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   value="@_filterText"
                   @oninput="HandleFilterInput"
                   onkeydown="if(event.key==='Enter')event.preventDefault()"
                   @onkeyup="HandleKeyUp" />
            @if (!string.IsNullOrEmpty(_filterText) && !Disabled)
            {
                <button type="button"
                        class="@(Headless ? null : "flare-checklist-search-clear")"
                        tabindex="-1"
                        aria-label="@Locale.Ui("clearFilter")"
                        @onclick="ClearFilter">&times;</button>
            }
        </div>
    }

    <div class="@(Headless ? null : "flare-checklist-list")"
         style="@ListStyle()"
         @ref="_list"
         id="@_listId"
         data-flare-listnav
         role="listbox"
         aria-multiselectable="true"
         aria-label="@ListLabel("aria-label")"
         aria-labelledby="@ListLabel("aria-labelledby")"
         aria-activedescendant="@(ActiveIndex >= 0 ? OptionId(ActiveIndex) : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-busy="@(_loading ? "true" : null)"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocus="HandleListFocus"
         @onkeydown="HandleListKeyDown">
        <Virtualize @ref="_virtualizer"
                    ItemsProvider="_itemsProvider"
                    ItemSize="ItemSize"
                    Context="row">
            <ItemContent>
                @{ var item = row.Item; }
                <div @key="GetKey(item)"
                     id="@OptionId(row.Index)"
                     class="@RowClass(item)"
                     role="option"
                     aria-selected="@(IsSelected(item) ? "true" : "false")"
                     aria-disabled="@(!IsSelected(item) && IsAtLimit ? "true" : null)"
                     aria-setsize="@_totalCount"
                     aria-posinset="@(row.Index + 1)"
                     data-flare-active="@(row.Index == ActiveIndex ? "true" : null)"
                     @onclick="() => HandleRowClick(row)">
                    <span class="@(Headless ? null : (IsSelected(item) ? "flare-checklist-check flare-checklist-checked" : "flare-checklist-check"))"
                          aria-hidden="true">
                        @if (IsSelected(item))
                        {
                            <text>&#x2713;</text>
                        }
                    </span>
                    <span class="@(Headless ? null : "flare-checklist-content")">
                        @if (ItemTemplate is not null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            @GetText(item)
                        }
                    </span>
                </div>
            </ItemContent>
            <Placeholder>
                <div class="@(Headless ? null : "flare-checklist-row flare-checklist-row-placeholder")"
                     style="height: @(ItemSize)px;">
                </div>
            </Placeholder>
        </Virtualize>

        @if (_searched && _totalCount > 0 && TruncatedText is not null && (TruncatedThreshold <= 0 || _totalCount >= TruncatedThreshold))
        {
            <div class="@(Headless ? null : "flare-checklist-truncated")">
                @TruncatedText
            </div>
        }
    </div>

    @* Status messages live outside the listbox: a listbox may only contain options. *@
    @if (_loading && _totalCount == 0)
    {
        <div class="@(Headless ? null : "flare-checklist-loading")" role="status">
            @(LoadingText ?? Locale.Ui("loading"))
        </div>
    }
    else if (_searched && _totalCount == 0)
    {
        <div class="@(Headless ? null : "flare-checklist-empty")" role="status">
            @(NotFoundText ?? Locale.Ui("noItems"))
        </div>
    }

    @if (ShowCount)
    {
        <div class="@(Headless ? null : "flare-checklist-footer")" aria-live="polite">
            @(MaxItems > 0 ? Locale.Ui("selectedMaxFormat", _selectedValues.Count, MaxItems) : Locale.Ui("selectedFormat", _selectedValues.Count))
        </div>
    }
</div>
