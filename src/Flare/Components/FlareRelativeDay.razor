@namespace Flare

@if (HasValue)
{
    <span @attributes="InputAttributes" class="flare-title @Class" data-flare-relative-day="@Value!.Value.UtcDateTime.ToString("o")" data-flare-title="@FormatTitle()">@FormatFallback()</span>
}
else if (!string.IsNullOrEmpty(Placeholder))
{
    <span @attributes="InputAttributes" class="@Class">@Placeholder</span>
}
