@namespace Flare
@typeparam TItem
@implements IAsyncDisposable

<div class="@RootClass()"
     @ref="_root"
     @onclick="FocusInput"
     @onfocusin="OpenIfSearchable">

    @* Selected tags *@
    @foreach (var item in _values)
    {
        var current = item;
        @* A removable tag is a button that removes itself. The key presses it handles are
           cancelled in flare-typeahead.js, so Tab still moves focus on. *@
        <span class="@(Headless ? null : $"flare-tagbox-tag{(Disabled ? "" : " flare-tagbox-tag-removable")}")"
              data-flare-tag
              role="@(Disabled ? null : "button")"
              tabindex="@(Disabled ? null : "0")"
              aria-label="@(Disabled ? null : Locale.Ui("removeFormat", GetText(current)))"
              @onkeydown="e => HandleTagKeyDown(e, current)"
              @onkeydown:stopPropagation
              @onpointerdown="() => RemoveTag(current)"
              @onpointerdown:stopPropagation>
            @if (TagTemplate is not null)
            {
                @TagTemplate(current)
            }
            else
            {
                @GetText(current)
            }
            @if (!Disabled)
            {
                <span class="@(Headless ? null : "flare-tagbox-tag-x")" aria-hidden="true">&times;</span>
            }
        </span>
    }

    @* Inline search input *@
    <input @ref="_input"
           @attributes="Attributes"
           type="text"
           role="combobox"
           autocomplete="off"
           aria-expanded="@(_isOpen && _items.Count > 0 ? "true" : "false")"
           aria-activedescendant="@ActiveDescendant()"
           aria-controls="@_listboxId"
           aria-autocomplete="list"
           class="@InputClass()"
           placeholder="@CurrentPlaceholder()"
           disabled="@IsDisabled"
           @oninput="HandleInput"
           @onclick="OpenIfSearchable"
           @onclick:stopPropagation
           @onkeydown="HandleKeyDown"
           @onkeydown:stopPropagation="@_isOpen"
           @onblur="HandleBlur" />

    @* Dropdown *@
    @if (_isOpen && _items.Count > 0)
    {
        <ul id="@_listboxId" role="listbox" class="@ListboxClass()">
            @for (var i = 0; i < _items.Count; i++)
            {
                var index = i;
                var item = _items[i];
                <li id="@OptionId(index)"
                    role="option"
                    class="@OptionClass(index)"
                    aria-selected="@(index == _highlightedIndex ? "true" : "false")"
                    @onpointerdown="() => SelectItem(item)"
                    @onpointerdown:preventDefault>
                    @if (ItemTemplate is not null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        @GetText(item)
                    }
                </li>
            }
        </ul>
    }
    else if (_isOpen && _loading)
    {
        <div class="@(Headless ? null : "flare-tagbox-dropdown flare-tagbox-loading")" role="status">
            @(LoadingText ?? Locale.Ui("searching"))
        </div>
    }
    else if (_isOpen && _searched && _items.Count == 0 && !string.IsNullOrWhiteSpace(_text))
    {
        <div class="@(Headless ? null : "flare-tagbox-dropdown flare-tagbox-empty")" role="status">
            @if (CreateItem is not null)
            {
                <span>@CreateHint().Before<strong>@_text.Trim()</strong>@CreateHint().After</span>
            }
            else
            {
                @(NotFoundText ?? Locale.Ui("noResults"))
            }
        </div>
    }
</div>
