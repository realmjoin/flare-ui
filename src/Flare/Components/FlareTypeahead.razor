@namespace Flare
@typeparam TItem
@implements IAsyncDisposable

<div class="@RootClass()" @ref="_root">
    <input @ref="_input"
           @attributes="Attributes"
           type="text"
           role="combobox"
           autocomplete="off"
           aria-expanded="@(_isOpen && _items.Count > 0 ? "true" : "false")"
           aria-activedescendant="@ActiveDescendant()"
           aria-controls="@_listboxId"
           aria-autocomplete="list"
           class="@InputClass()"
           placeholder="@Placeholder"
           disabled="@Disabled"
           @oninput="HandleInput"
           @onkeydown="HandleKeyDown"
           @onkeydown:stopPropagation="@_isOpen"
           @onfocus="HandleFocus"
           @onblur="HandleBlur" />

    @if (!string.IsNullOrEmpty(_text) && !Disabled)
    {
        <button type="button"
                class="@(Headless ? null : "flare-typeahead-clear")"
                tabindex="-1"
                aria-label="@Locale.Ui("clear")"
                @onpointerdown="HandleClear"
                @onpointerdown:preventDefault>
            &times;
        </button>
    }

    @if (_isOpen && _items.Count > 0)
    {
        <ul id="@_listboxId" role="listbox" class="@ListboxClass()">
            @for (var i = 0; i < _items.Count; i++)
            {
                var index = i;
                var item = _items[i];
                <li id="@OptionId(index)"
                    role="option"
                    class="@OptionClass(index)"
                    aria-selected="@(index == _highlightedIndex ? "true" : "false")"
                    @onpointerdown="() => SelectItem(item)"
                    @onpointerdown:preventDefault>
                    @if (ItemTemplate is not null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        @GetText(item)
                    }
                </li>
            }
        </ul>
    }
    else if (_isOpen && _loading)
    {
        <div class="@(Headless ? null : "flare-typeahead-dropdown flare-typeahead-loading")" role="status">
            @(LoadingText ?? Locale.Ui("searching"))
        </div>
    }
    else if (_isOpen && _searched && _items.Count == 0 && !string.IsNullOrWhiteSpace(_text))
    {
        <div class="@(Headless ? null : "flare-typeahead-dropdown flare-typeahead-empty")" role="status">
            @if (CreateItem is not null)
            {
                <span>@CreateHint().Before<strong>@_text.Trim()</strong>@CreateHint().After</span>
            }
            else
            {
                @(NotFoundText ?? Locale.Ui("noResults"))
            }
        </div>
    }
</div>
